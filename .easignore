coverage.json
coverage.xml
htmlcov/
.coverage
.coverage.*

# Claude Code session scratch
.claude/

# Local tool state
.lsp.json
.pi/
# tokensave's code-graph database, per-checkout and machine-local. The SQLite
# WAL/shm sidecars change on every read, so tracking them made `jj st` dirty
# constantly and dragged a 30MB binary toward every commit.
.tokensave/

.superpowers/

/node_modules/

# TS incremental build cache -- also .gitignore'd per-project (web-react/.gitignore)
# but bun workspace members under packages/* don't each carry their own, so this
# generic rule covers them.
*.tsbuildinfo

# ---------------------------------------------------------------------------
# EAS upload excludes (everything above is inherited from .gitignore, because
# when this file exists EAS may use it INSTEAD of .gitignore -- so it must be a
# strict superset, or node_modules/.venv/build would be re-included).
#
# An EAS build only needs what `bun install` at the workspace root touches plus
# the Expo app itself: the root manifest and lockfile, mobile/, and
# packages/pifire-core (which mobile imports as @pifire/core). Everything below
# is PiFire's Raspberry Pi backend, its web client's sources, or local tooling
# state -- none of it participates in building the phone app.
# ---------------------------------------------------------------------------

# Version-control internals. .jj is 829MB here and, unlike .git, no tool
# excludes it by default -- it was the bulk of a 228MB upload.
.jj/
.git/

# Python backend, hardware drivers, installer, and their tests.
auto-install/
common/
controller/
display/
notify/
probes/
tests/
updater/
wizard/
recipes/
training/
tools/
*.py
pyproject.toml
uv.lock
ruff.toml
prek.toml
pytest.ini

# Docs and media (docs/ alone carries ~45MB of photos).
docs/
static/
*.md
!mobile/README.md

# The web client's sources. Its package.json MUST remain: it is a declared bun
# workspace member, and bun hard-errors on a workspace path that does not exist.
web-react/*
!web-react/package.json

# Local tool caches that no build needs.
.ruff_cache/
.pytest_cache/
.mypy_cache/
htmlcov/
__pycache__/
