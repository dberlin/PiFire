{
  "expo": {
    "name": "PiFire",
    "slug": "pifire-mobile",
    "scheme": "pifire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.dberlin.pifire.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.dberlin.pifire.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#959595",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "owner": "danberlins-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4b5a56f-5a06-4bed-b73c-c4d646ca0b33"
      }
    }
  }
}
