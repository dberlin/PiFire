{
  "name": "pifire-react-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "POC: React reimplementation of the PiFire QT Quick on-device controller UI (remote browser app).",
  "scripts": {
    "dev": "rsbuild dev",
    "demo": "PUBLIC_DEMO=1 rsbuild dev",
    "typecheck": "node node_modules/typescript7/bin/tsc -b",
    "build": "bun run typecheck && rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest run",
    "test:coverage": "rstest run --coverage",
    "test:e2e": "playwright test",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "gen:types": "bun scripts/gen-types.ts",
    "gen:types:check": "bun scripts/gen-types.ts --check"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "socket.io-client": "^4.8.3",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.62.0",
    "@rsbuild/core": "2.1.8",
    "@rsbuild/plugin-react": "2.1.0",
    "@rstest/core": "0.11.4",
    "@rstest/coverage-istanbul": "^0.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
