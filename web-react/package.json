{
  "name": "pifire-react-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "POC: React reimplementation of the PiFire QT Quick on-device controller UI (remote browser app).",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "rsbuild dev",
    "demo": "PUBLIC_DEMO=1 rsbuild dev",
    "typecheck": "node node_modules/typescript7/bin/tsc -b",
    "typecheck:e2e": "node node_modules/typescript7/bin/tsc -p tsconfig.e2e.json --noEmit",
    "build": "bun run typecheck && rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest run",
    "test:coverage": "rstest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:fidelity": "playwright test --project=fidelity-pages --project=fidelity-chrome --project=fidelity-pellets --project=fidelity --project=reflow --project=panel",
    "baseline:capture": "PF_CAPTURE=1 playwright test --project=fidelity-pages --project=fidelity-chrome --project=fidelity-pellets --project=fidelity",
    "lint": "biome check . && eslint .",
    "format": "biome format --write .",
    "gen:types": "bun scripts/gen-types.ts --write",
    "gen:types:check": "bun scripts/gen-types.ts --check"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@melloware/react-logviewer": "6.5.5",
    "@pifire/core": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@rsbuild/core": "2.2.1",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rstest/core": "0.11.10",
    "@rstest/coverage-istanbul": "^0.11.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "8.68.0",
    "dom-accessibility-api": "^0.7.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^16.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
