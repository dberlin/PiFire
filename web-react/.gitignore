node_modules/
dist/

# The bun downloaded to build with, kept between rebuilds so a grill does not
# re-fetch ~90MB every time. Not a dependency of anything that runs.
.bun-toolchain/
*.local
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# TS incremental build cache
*.tsbuildinfo

# Generated istanbul coverage output (bun run test:coverage)
coverage/

# Playwright review artifacts: wizard step captures plus the dashboard
# fidelity/reflow pair. Regenerated on every run and kept as a human reference
# (before.png vs the fresh capture) -- never asserted against, since the fonts
# load from the network and pixels are host-dependent.
tests/e2e/artifacts/
