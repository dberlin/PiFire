{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Nested under the repo-root biome.json, which formats JSON everywhere
  // else. This one owns everything in web-react/ -- JS, TS, CSS and JSON --
  // and its rules are unchanged by that arrangement.
  "root": false,
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "*.json",
      "*.ts",
      "*.js",
      "index.html",
      "!dist",
      "!node_modules",
      "!src/helpers/settings/settingsTypes.gen.ts",
      // Generated by `uv run python -m common.settings_schema`, and a drift
      // check compares the committed file against a fresh run. Formatting it
      // here would only be undone by the next regeneration.
      "!schema/**"
    ]
  },
  // Biome 2.5.5 treats @theme / @apply / @reference as a PARSE ERROR without
  // this, and a parse error aborts formatting of the whole file -- so the
  // Tailwind v4 migration would have made `bun run lint` unrunnable rather than
  // merely noisy. Measured:
  //
  //   × Tailwind-specific syntax is disabled.
  //   i Enable `tailwindDirectives` in the css parser options.
  //
  // Scoped to the CSS parser only; no lint rule is relaxed. noDescendingSpecificity
  // and the rest still run over every stylesheet, and none of them fire on
  // @apply bodies -- the migration changes declarations, never selectors.
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // All findings are on existing modal/gauge widgets (click-to-dismiss
        // scrims, SVG gauge, buttons without an explicit type). Per house
        // rules, a11y widget restructuring is out of scope here — scheduled
        // as a separate follow-up.
        "useButtonType": "off",
        "useGenericFontNames": "off",
        "useKeyWithClickEvents": "off",
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off"
      },
      "style": {
        // 6 pre-existing `!` assertions (DOM root lookup in main.tsx,
        // confirm-modal state narrowed by a JSX guard, and test
        // `querySelector(...)!` calls already preceded by a
        // `.not.toBeNull()` check). Removing them needs real null-narrowing
        // refactors per call site; deferred.
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        // 2 pre-existing React `key={i}` uses in Banners/Dashboard list
        // rendering over arrays regenerated in stable order from live
        // socket data each render — not a correctness bug, deferred rather
        // than restructured.
        "noArrayIndexKey": "off"
      },
      "complexity": {
        // The single `animation: none !important` in dashboard.css is a
        // deliberate override to force-kill @keyframes animations when the
        // "reduce motion" toggle is off; removing !important would break
        // that feature.
        "noImportantStyles": "off"
      }
    }
  },
  "overrides": [
    {
      // PortForm renders the 5 wizard_manifest.json probe_config_options
      // descriptions verbatim (static trusted manifest copy, not user
      // input) -- mirrors legacy Jinja `|safe` rendering of the same
      // strings. Scoped off here rather than globally.
      "includes": ["src/components/wizard/probes/PortForm.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
