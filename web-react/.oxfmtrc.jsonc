{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Owns everything in web-react/ -- JS, TS, CSS and JSON -- plus the two
  // @pifire/core trees the Pydantic exporter writes into, which sit outside
  // this directory but are formatted through this config by
  // scripts/emitWebContracts.ts.
  //
  // oxfmt resolves the nearest config per file, so this one governs
  // web-react/** entirely; the repo-root config never applies here.
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "src/helpers/settings/settingsDefaults.gen.ts",
    // Written by the registered Pydantic web-contract exporter. Formatting it
    // here would only be undone by the next `bun run gen:types`.
    "schema/**",
  ],
  // Import sorting is a gate, not a nicety: it was previously enforced and the
  // codebase is already sorted. Leaving this off would let imports drift.
  "sortImports": {},
  // On by default. Reordering hand-maintained package.json files is churn.
  "sortPackageJson": false,
}
